# Пример настроек для локальной разработки: скопировать в .env
# На сервере те же переменные задаются в /etc/mail_backup/mail_backup.env

# dev — бэкапы где угодно; prod — только на смонтированном отдельном диске
MB_DEPLOY_MODE=dev

# Каталог данных приложения: БД, логи imapsync, временные файлы
MB_DATA_DIR=./var/data
# Корень хранилища бэкапов (на сервере — точка монтирования отдельного диска)
MB_BACKUP_ROOT=./var/backup
# Каталог с секретами: ключ шифрования паролей и ключ сессий
MB_SECRETS_DIR=./var/secrets

# Локальный Dovecot, в который складываются бэкапы
MB_LOCAL_IMAP_HOST=127.0.0.1
MB_LOCAL_IMAP_PORT=143

MB_IMAPSYNC_BIN=imapsync
MB_MAX_PARALLEL_JOBS=2
